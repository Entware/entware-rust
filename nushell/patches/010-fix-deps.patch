--- a/Cargo.toml
+++ b/Cargo.toml
@@ -509,6 +509,20 @@ bench = false

 # Run all benchmarks with `cargo bench`
 # Run individual benchmarks like `cargo bench -- <regex>` e.g. `cargo bench -- parse`
+
+# localtime/zoneinfo
+chrono = { path = "../chrono-0.4.44" }
+iana-time-zone = { path = "../iana-time-zone-0.1.64" }
+# openssl
+openssl-probe1 = { path = "../openssl-probe-0.1.6", package = "openssl-probe", version = "0.1.6" }
+openssl-probe2 = { path = "../openssl-probe-0.2.1", package = "openssl-probe", version = "0.2.1" }
+# all: no SYS_getrandom
+getrandom2 = { path = "../getrandom-0.2.17", package = "getrandom", version = "0.2.17" }
+getrandom3 = { path = "../getrandom-0.3.4", package = "getrandom", version = "0.3.4" }
+getrandom4 = { path = "../getrandom-0.4.2", package = "getrandom", version = "0.4.2" }
+# mips/mipsel: error[E0432]: unresolved import `std::sync::atomic::AtomicU64`
+rmcp = { path = "../rmcp-3.1.0/crates/rmcp" }
+
 [[bench]]
 name = "benchmarks"
 harness = false
